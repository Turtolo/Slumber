{
    "root": "",
    "references": [],
    "content": {
        "textures": {
            "path": "Graphics/*.png",
            "recursive": "True",
            "action": "build",
            "importer": "TextureImporter",
            "processor": "TextureProcessor",
            "processorParam": {
                "ColorKeyColor": "255,0,255,255",
                "ColorKeyEnabled": "True",
                "GenerateMipmaps": "False",
                "PremultiplyAlpha": "True",
                "ResizeToPowerOfTwo": "False",
                "MakeSquare": "False",
                "TextureFormat": "Color"
            }
        },
        "maps_png": {
            "path": "Maps/*.png",
            "recursive": "True",
            "action": "build",
            "importer": "TextureImporter",
            "processor": "TextureProcessor",
            "processorParam": {
                "ColorKeyColor": "255,0,255,255",
                "ColorKeyEnabled": "True",
                "GenerateMipmaps": "False",
                "PremultiplyAlpha": "True",
                "ResizeToPowerOfTwo": "False",
                "MakeSquare": "False",
                "TextureFormat": "Color"
            }
        },
        "maps_tmx": {
            "path": "Maps/*.tmx",
            "recursive": true,
            "action": "copy"
        }
    }
}